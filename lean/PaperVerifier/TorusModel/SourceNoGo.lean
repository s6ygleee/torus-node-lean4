/-
  Exact general lemmas used by the source no-go theorem,
  Theorem 3.12 (`thm:literal`).

  These declarations isolate the analytic divergence mechanism, the
  determinant-weight inverse asymmetry, the commutativity of scalar transport,
  and the state-measure non-identifiability witness.  They do not identify the
  manuscript's unrestricted GL₂⁺(ℚ) kernel with a normalized source.
-/
import Mathlib.Analysis.SpecificLimits.Normed
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.MeasureTheory.Measure.Dirac
import Mathlib.Tactic.Ring

namespace TorusModel.SourceNoGo

open Filter MeasureTheory

/-- A real series whose terms converge to one cannot be summable.  This is
    the analytic core of part (a) of the unrestricted-source no-go theorem. -/
theorem not_summable_of_tendsto_one
    (w : ℕ → ℝ) (hw : Tendsto w atTop (nhds 1)) :
    ¬Summable w := by
  intro hs
  have hzero : Tendsto w atTop (nhds 0) := hs.tendsto_atTop_zero
  have hone_zero : (1 : ℝ) = 0 := tendsto_nhds_unique hw hzero
  norm_num at hone_zero

/-- Exact exponential form of the ratio
    `2⁻ᵝ / 2ᵝ = 2⁻²ᵝ` used in part (b). -/
theorem inverse_weight_ratio_two (β : ℝ) :
    Real.exp (-β * Real.log 2) / Real.exp (β * Real.log 2) =
      Real.exp (-(2 * β) * Real.log 2) := by
  rw [← Real.exp_sub]
  congr 1
  ring

/-- A transport factor with values in a commutative scalar monoid has
    commuting image.  A non-abelian history action therefore cannot be
    generated by this scalar factor alone. -/
theorem scalar_transport_commutes
    {G R : Type*} [CommMonoid R] (χ : G → R) (g h : G) :
    χ g * χ h = χ h * χ g := by
  exact mul_comm _ _

/-- Distinct states give distinct Dirac state measures whenever the measurable
    space separates points.  Thus a geometric kernel that does not select the
    state variable cannot determine which of these two state measures is used. -/
theorem distinct_dirac_state_measures
    {Ω : Type*} [MeasurableSpace Ω] [MeasurableSpace.SeparatesPoints Ω]
    {ψ₀ ψ₁ : Ω} (hψ : ψ₀ ≠ ψ₁) :
    Measure.dirac ψ₀ ≠ Measure.dirac ψ₁ := by
  exact MeasureTheory.dirac_ne_dirac hψ

/-- Pack the four exact algebraic/analytic cores used by the unrestricted
    source no-go discussion.  The theorem does not identify the displayed
    `GL₂⁺(ℚ)` kernel with these abstractions; that model-level identification
    remains a separate obligation. -/
theorem source_no_go_core
    (w : ℕ → ℝ) (hw : Tendsto w atTop (nhds 1))
    (β : ℝ)
    {G R : Type*} [CommMonoid R] (φ : G → R) (g h : G)
    {α : Type*} [MeasurableSpace α] [MeasurableSpace.SeparatesPoints α]
    {x y : α} (hxy : x ≠ y) :
    (¬ Summable w) ∧
      (Real.exp (-β * Real.log 2) / Real.exp (β * Real.log 2) =
        Real.exp (-(2 * β) * Real.log 2)) ∧
      (φ g * φ h = φ h * φ g) ∧
      (Measure.dirac x ≠ Measure.dirac y) := by
  refine ⟨not_summable_of_tendsto_one w hw,
    inverse_weight_ratio_two β,
    scalar_transport_commutes φ g h,
    distinct_dirac_state_measures hxy⟩

end TorusModel.SourceNoGo
